# Marzban panel this backend manages. MARZBAN_USERNAME/PASSWORD is a service account
# used only for this backend's own unattended calls (the nightly sync job, etc).
# It is NOT a separate dashboard password — logging into the dashboard/bot uses
# whatever admin credentials Marzban itself already accepts (checked live against
# Marzban's own /api/admin/token on every login, see app/routers/auth.py).
MARZBAN_BASE_URL=https://your-marzban-domain:port
MARZBAN_USERNAME=sudo_admin_username
MARZBAN_PASSWORD=sudo_admin_password

# Local database (SQLite for dev; swap to postgresql:// for production)
DATABASE_URL=sqlite:///./vpn.db

# Session length for dashboard/bot logins. No JWT_SECRET here on purpose — it's
# auto-generated into backend/.jwt_secret on first run.
JWT_EXPIRE_MINUTES=1440

# Where that auto-generated secret is stored. Blank = backend/.jwt_secret,
# which is correct for a local checkout. Under Docker it MUST point inside the
# data volume (docker-compose.yml already sets /app/data/.jwt_secret) —
# otherwise the file lives in the image layer and every rebuild mints a new
# secret, logging every dashboard and bot session out.
JWT_SECRET_FILE=

# Telegram bot
BOT_TOKEN=
BOT_ADMIN_CHAT_ID=
BOT_API_BASE_URL=http://127.0.0.1:8000

# Sync job — also the worst-case delay before a customer whose plan just ran
# out gets reconnected via the next-plan feature, so this is in seconds, not
# minutes. Marzban runs on the same server, so polling this often is cheap.
SYNC_INTERVAL_SECONDS=60

# Nightly backup: safely copies the database, zips it, and sends it to
# BOT_ADMIN_CHAT_ID above (needs BOT_TOKEN/BOT_ADMIN_CHAT_ID set — skipped
# automatically otherwise). Server's own local time, 24h.
BACKUP_HOUR=3
BACKUP_MINUTE=30

# Daily check (server's own local time, 24h) for "does a real Jalali (Persian)
# calendar month end tonight" — see docs/DOMAIN_AND_BILLING.md §4.4. Most days
# this is a no-op; it only actually settles anything on the last night of a
# Jalali month.
PAYG_MONTHLY_SETTLE_HOUR=23
PAYG_MONTHLY_SETTLE_MINUTE=30

# Optional. Only set this if your Marzban serves subscription links from a
# DIFFERENT public host than the panel itself. Left blank, subscription links
# are resolved against MARZBAN_BASE_URL above, which is right for the usual
# single-host setup. Marzban only returns a relative "/sub/<token>" when its
# own XRAY_SUBSCRIPTION_URL_PREFIX is unset — when it returns an absolute URL,
# this setting is ignored and that URL is used as-is.
MARZBAN_SUBSCRIPTION_BASE_URL=

# Weekly heads-up (server's own local time, 24h + day) for customers whose
# REAL posted debt has been outstanding a while — see
# backend/app/debt_nudge_job.py for the "duration not amount" reasoning.
# Sends nothing most weeks by design; not a bug if you don't see it fire.
DEBT_NUDGE_DAY_OF_WEEK=mon
DEBT_NUDGE_HOUR=9
DEBT_NUDGE_MINUTE=0

# Comma-separated origins allowed to call this API from a browser.
# LEFT BLANK, THIS DEFAULTS TO "*" — any website can call this API from a
# visitor's browser. That is survivable only because auth here is a Bearer
# token in a header, not a cookie: a third-party origin's script has no way to
# obtain the token, so it cannot ride an existing session. Still, set this to
# your real dashboard origin(s) the moment the API is reachable from anywhere
# but a trusted network.
# Example: CORS_ALLOWED_ORIGINS=https://panel.example.com,http://192.168.1.10:8011
CORS_ALLOWED_ORIGINS=

# ── Self-serve shop (optional; leave blank to run without one) ──────────────
# Shared secret the customer-facing shop bot presents on /api/shop/bot/*.
# Must match SHOP_BOT_API_KEY in shopbot/.env exactly. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# BLANK = every /api/shop/bot/* request is refused. That is the intended
# behaviour when there is no shop, not a misconfiguration to work around.
# This is deliberately NOT the Marzban admin credentials: the shop bot takes
# messages from the public, so it gets a key that opens the shop endpoints
# and nothing else.
SHOP_BOT_API_KEY=

# Telegram token of the SHOP bot (a different bot from BOT_TOKEN above). The
# backend needs it to push a purchased account's QR straight to the buyer, and
# to tell them when you approve or reject their payment — neither of which has
# an open request to reply on.
SHOP_BOT_TOKEN=

# ── Delegated self-service (optional; leave blank to run without any) ──────
# Shared secret delegate_bot presents on /api/delegate/bot/*. Must match
# DELEGATE_BOT_API_KEY in delegate_bot/.env exactly. Generate a fresh one the
# same way as SHOP_BOT_API_KEY above. BLANK = every /api/delegate/bot/*
# request is refused — the intended state until you grant a customer access
# via the operator bot's /delegate_add.
DELEGATE_BOT_API_KEY=
