# Marzban panel this backend manages. MARZBAN_USERNAME/PASSWORD is a service account
# used only for this backend's own unattended calls (the nightly sync job, etc).
# It is NOT a separate dashboard password — logging into the dashboard/bot uses
# whatever admin credentials Marzban itself already accepts (checked live against
# Marzban's own /api/admin/token on every login, see app/routers/auth.py).
MARZBAN_BASE_URL=https://your-marzban-domain:port
MARZBAN_USERNAME=sudo_admin_username
MARZBAN_PASSWORD=sudo_admin_password

# Local database (SQLite for dev; swap to postgresql:// for production)
DATABASE_URL=sqlite:///./vpn.db

# Session length for dashboard/bot logins. No JWT_SECRET here on purpose — it's
# auto-generated into backend/.jwt_secret on first run.
JWT_EXPIRE_MINUTES=1440

# Telegram bot
BOT_TOKEN=
BOT_ADMIN_CHAT_ID=
BOT_API_BASE_URL=http://127.0.0.1:8000

# Sync job — also the worst-case delay before a customer whose plan just ran
# out gets reconnected via the next-plan feature, so this is in seconds, not
# minutes. Marzban runs on the same server, so polling this often is cheap.
SYNC_INTERVAL_SECONDS=60

# Nightly backup: safely copies the database, zips it, and sends it to
# BOT_ADMIN_CHAT_ID above (needs BOT_TOKEN/BOT_ADMIN_CHAT_ID set — skipped
# automatically otherwise). Server's own local time, 24h.
BACKUP_HOUR=3
BACKUP_MINUTE=30

# Daily check (server's own local time, 24h) for "does a real Jalali (Persian)
# calendar month end tonight" — see docs/DOMAIN_AND_BILLING.md §4.4. Most days
# this is a no-op; it only actually settles anything on the last night of a
# Jalali month.
PAYG_MONTHLY_SETTLE_HOUR=23
PAYG_MONTHLY_SETTLE_MINUTE=30

# Optional. Only set this if your Marzban serves subscription links from a
# DIFFERENT public host than the panel itself. Left blank, subscription links
# are resolved against MARZBAN_BASE_URL above, which is right for the usual
# single-host setup. Marzban only returns a relative "/sub/<token>" when its
# own XRAY_SUBSCRIPTION_URL_PREFIX is unset — when it returns an absolute URL,
# this setting is ignored and that URL is used as-is.
MARZBAN_SUBSCRIPTION_BASE_URL=
