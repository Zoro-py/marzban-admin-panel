# Python
backend/venv/
bot/venv/
shopbot/venv/
delegate_bot/venv/
__pycache__/
*.pyc

# Env files with real secrets
.env
backend/.env
bot/.env
frontend/.env
shopbot/.env
delegate_bot/.env

# Backend local dev DB + auto-generated JWT signing secret
backend/vpn.db
backend/vpn.db-*
backend/.jwt_secret
# Any SQLite DB under backend/, not just the two names above. This repo is
# public and these files hold real customer names, contacts and ledger
# history — a DB named anything else (marzban_admin.db, a dated copy taken
# before a migration) was previously untracked-but-committable, one
# `git add -A` away from being published.
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/*.sqlite
backend/*.sqlite3

# scripts/install.sh's own resume-state (subdomains/email from the last run)
.install_state

# Frontend
frontend/node_modules/
frontend/dist/

# Logs / dev-server pid files from local runs
*.log
*.pid
predeploy-backups/
