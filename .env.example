# Used only by docker-compose.yml to bake the right backend URL into the frontend
# build. Must be an address your BROWSER can reach — the server's public IP or
# domain, not a Docker-internal service name.
PUBLIC_BACKEND_URL=http://your-server-ip:8010
# Where ports 8010 (API) and 8011 (dashboard) listen. Leave unset for the IP-only
# setup above (every interface). Behind nginx on the same box, set 127.0.0.1 so the
# API can only be reached through it.
# BIND_ADDRESS=127.0.0.1
