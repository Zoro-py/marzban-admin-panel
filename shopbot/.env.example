# Telegram token for the CUSTOMER-FACING shop bot, from @BotFather.
# Must be a DIFFERENT bot from the operator's admin bot in bot/.env — this one
# accepts messages from anyone, that one is locked to a single chat id.
SHOP_BOT_TOKEN=

# This backend's API.
# Running the bot directly on your machine: http://127.0.0.1:8000
# Running it under docker-compose: http://backend:8000 — 127.0.0.1 inside the
# shopbot container means the CONTAINER itself, not the backend, so the bot
# would fail every request while looking correctly configured.
API_BASE_URL=http://127.0.0.1:8000

# Shared secret for /api/shop/bot/*. Must match SHOP_BOT_API_KEY in
# backend/.env exactly. Generate a fresh random one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This is the ONLY credential this process holds, on purpose: it opens the
# shop's customer endpoints and nothing else. Never put the Marzban admin
# credentials here.
SHOP_BOT_API_KEY=
