# Telegram token of the dedicated PAYMENTS bot (@BotFather) — receipts relay
# here from the backend (backend/.env RECEIPTS_BOT_TOKEN must hold the SAME
# token). Deliberately a THIRD bot: the operator bot stays the everything-bot
# (accounts, sync, alarms), the shop bot is the customers', and this one is
# only the operator's payments inbox.
RECEIPTS_BOT_TOKEN=

# This backend's API.
# Running the bot directly on your machine: http://127.0.0.1:8000
# Running it under docker-compose: http://backend:8000
API_BASE_URL=http://127.0.0.1:8000

# Same operator credentials bot/.env uses — approving a top-up moves real
# money, so this bot authenticates exactly like the operator bot does.
MARZBAN_USERNAME=
MARZBAN_PASSWORD=

# The ONLY chat id this bot answers (the operator's own telegram id — same
# value as bot/.env's ADMIN_CHAT_ID / backend/.env's BOT_ADMIN_CHAT_ID).
ADMIN_CHAT_ID=
