# Telegram token for the DELEGATE self-service bot, from @BotFather.
# Must be a DIFFERENT bot from both bot/.env (the operator's own bot) and
# shopbot/.env (the public shop bot) — this one accepts messages only from
# customers the operator has explicitly granted access via /delegate_add,
# but it is still its own process/token on the same reasoning as shopbot's:
# see delegate_bot/api_client.py's module docstring.
DELEGATE_BOT_TOKEN=

# This backend's API.
# Running the bot directly on your machine: http://127.0.0.1:8000
# Running it under docker-compose: http://backend:8000
API_BASE_URL=http://127.0.0.1:8000

# Shared secret for /api/delegate/bot/*. Must match DELEGATE_BOT_API_KEY in
# backend/.env exactly. Generate a fresh random one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This is the ONLY credential this process holds, on purpose: it opens the
# delegate self-service endpoints and nothing else — never the ledger,
# never the Marzban admin credentials. Never put those here.
DELEGATE_BOT_API_KEY=
